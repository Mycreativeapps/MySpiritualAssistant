# ─────────────────────────────────────────────
# MySpiritualCoach — Production Environment
# Copy this to .env.production and fill values
# NEVER commit .env.production to git!
# ─────────────────────────────────────────────

# Server
PORT=3000
NODE_ENV=production

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@your-rds-host:5432/dbname

# JWT
JWT_SECRET=your_very_long_random_secret_here

# Email (GoDaddy SMTP)
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=contact@myspiritualassistant.com
EMAIL_PASS=your_godaddy_email_password

# Firebase (paste the entire JSON as a single line)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# OTP Cooldown (seconds)
OTP_COOLDOWN_SECONDS=60
